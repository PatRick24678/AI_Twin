{
  "name": "tatoma-future-self-local",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node --env-file=.env --import=./lib/load-secrets.mjs --watch server.mjs",
    "start": "node --env-file=.env --import=./lib/load-secrets.mjs server.mjs",
    "test": "node --test",
    "init:storage": "node scripts/init-storage.mjs",
    "check:secrets": "node --import=./lib/load-secrets.mjs -e \"console.log('API key loaded; value hidden.')\""
  }
}
