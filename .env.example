PORT=3000
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_MS=120000
# Optional voice mode. The MISTRAL_API_KEY belongs in the external secrets.env, never here.
MISTRAL_STT_MODEL=voxtral-mini-latest
MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
# Set to off to record first and transcribe afterwards (no live words).
MISTRAL_LIVE=on
# Optional face for the future self. The OPENAI_API_KEY belongs in the external secrets.env, never here.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# low, medium, high or auto. Higher costs more and takes longer.
OPENAI_IMAGE_QUALITY=medium
# Saved accounts: the key comes from npm.cmd run init:storage (external secrets.env), never from here.
# FUTURE_SELF_DB=D:\private\future-self.db
# FUTURE_SELF_SECURE_COOKIES=1   (only when served over HTTPS)
# Hosted database: DATABASE_URL (Neon Postgres) belongs in the external secrets.env or the host's secret store, never here.

# Hosting (docs/DEPLOYMENT.md). Leave these unset for local use: the app then stays localhost-only.
# PUBLIC_ORIGINS=https://future-self-xxxxx.europe-west4.run.app   (the https origin(s) the server answers to)
# HOST=0.0.0.0          (listen address; the container sets it)
# TRUST_PROXY=1         (the visitor address is the last X-Forwarded-For entry, as behind Cloud Run)
# AI_CONCURRENCY=4      (parallel AI requests; locally 1)
# MAX_SESSIONS=20       (open sessions at once)
# ACCESS_CODE belongs in the host's secret store: the shared code for guest sessions and new accounts.
