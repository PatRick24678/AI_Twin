PORT=3000
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_MS=120000
# Optional voice mode. The MISTRAL_API_KEY belongs in the external secrets.env, never here.
MISTRAL_STT_MODEL=voxtral-mini-latest
MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
# Set to off to record first and transcribe afterwards (no live words).
MISTRAL_LIVE=on
